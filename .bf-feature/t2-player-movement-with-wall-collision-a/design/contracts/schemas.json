{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Data schemas for T2 player movement contracts",
  "definitions": {
    "MovePlayerRequest": {
      "type": "object",
      "description": "Input to move_player: current position and keyboard state",
      "properties": {
        "x": {
          "type": "integer",
          "description": "Current player X coordinate (pixels)"
        },
        "y": {
          "type": "integer",
          "description": "Current player Y coordinate (pixels)"
        },
        "keysPressed": {
          "type": "object",
          "description": "Map of pygame key constants to boolean held state",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "required": ["x", "y", "keysPressed"]
    },
    "MovePlayerResponse": {
      "type": "object",
      "description": "Output of move_player: clamped updated position",
      "properties": {
        "x": {
          "type": "integer",
          "description": "Updated and clamped player X coordinate"
        },
        "y": {
          "type": "integer",
          "description": "Updated and clamped player Y coordinate"
        }
      },
      "required": ["x", "y"]
    },
    "WallBoundaryConfig": {
      "type": "object",
      "description": "Room-interior clamp boundaries derived from wall geometry",
      "properties": {
        "xMin": {
          "type": "integer",
          "description": "_X_MIN == WALL_THICKNESS"
        },
        "xMax": {
          "type": "integer",
          "description": "_X_MAX == LOGICAL_WIDTH - WALL_THICKNESS - PLAYER_SIZE"
        },
        "yMin": {
          "type": "integer",
          "description": "_Y_MIN == WALL_THICKNESS"
        },
        "yMax": {
          "type": "integer",
          "description": "_Y_MAX == LOGICAL_HEIGHT - WALL_THICKNESS - PLAYER_SIZE"
        }
      },
      "required": ["xMin", "xMax", "yMin", "yMax"]
    }
  }
}
